{
  "name": "avyaya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint",
    "db:seed-prompts": "npx tsx scripts/seed-prompts.ts",
    "db:verify-prompts": "npx tsx scripts/verify-parity.ts",
    "d1:seed": "npx tsx scripts/export-d1-prompts.ts && npx wrangler d1 execute avyaya-db --remote --file=d1/prompts.sql -y"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "bcrypt-ts": "^9.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jose": "^6.2.13",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.154.0"
  }
}
