{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "avyaya",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Once xylozentech.com is added as a Website in your Cloudflare account, uncomment this route:
	// "routes": [
	// 	{
	// 		"pattern": "avyaya.xylozentech.com",
	// 		"custom_domain": true
	// 	}
	// ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "avyaya-db",
			"database_id": "d67bef67-cbff-4c5e-853f-66d596da1581"
		}
	],
	"observability": {
		"enabled": true
	}
}
